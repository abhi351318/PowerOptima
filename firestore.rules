rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUserProfile(data) {
        return data.keys().hasAll(['userId', 'email'])
          && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
          && data.email is string && data.email.size() <= 256
          && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
          && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
          && (!('monthlyBudget' in data) || (data.monthlyBudget is number))
          && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
          && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);

      // User History Subcollection
      match /history/{historyId} {
        function isValidHistoryItem(data) {
          return data.keys().hasAll(['id', 'userId', 'title'])
            && data.id is string && data.id.size() <= 128
            && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
            && data.title is string && data.title.size() <= 256
            && (!('buildingId' in data) || (data.buildingId is string && data.buildingId.size() <= 64))
            && (!('meterId' in data) || (data.meterId is string && data.meterId.size() <= 64))
            && (!('dateRange' in data) || (data.dateRange is string && data.dateRange.size() <= 128))
            && (!('totalKwh' in data) || (data.totalKwh is number))
            && (!('totalCost' in data) || (data.totalCost is number))
            && (!('projectedSavings' in data) || (data.projectedSavings is number))
            && (!('forecastReliabilityScore' in data) || (data.forecastReliabilityScore is number))
            && (!('mae' in data) || (data.mae is number))
            && (!('rmse' in data) || (data.rmse is number))
            && (!('datasetSummary' in data) || (data.datasetSummary is string && data.datasetSummary.size() <= 10000))
            && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(historyId) && isValidHistoryItem(request.resource.data);
        allow update: if isOwner(userId) && isValidHistoryItem(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }

      // User Tariff Configuration Subcollection
      match /tariffs/{tariffId} {
        function isValidTariff(data) {
          return data.keys().hasAll(['id', 'userId', 'name'])
            && data.id is string && data.id.size() <= 128
            && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
            && data.name is string && data.name.size() <= 128
            && (!('peakRate' in data) || (data.peakRate is number))
            && (!('normalRate' in data) || (data.normalRate is number))
            && (!('offPeakRate' in data) || (data.offPeakRate is number))
            && (!('fixedMonthlyCharge' in data) || (data.fixedMonthlyCharge is number))
            && (!('demandChargePerKw' in data) || (data.demandChargePerKw is number))
            && (!('taxPercentage' in data) || (data.taxPercentage is number))
            && (!('peakHours' in data) || (data.peakHours is string && data.peakHours.size() <= 256))
            && (!('offPeakHours' in data) || (data.offPeakHours is string && data.offPeakHours.size() <= 256))
            && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tariffId) && isValidTariff(request.resource.data);
        allow update: if isOwner(userId) && isValidTariff(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
